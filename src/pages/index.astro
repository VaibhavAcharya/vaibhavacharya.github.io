---
import BaseHead from "../components/BaseHead.astro";
import Colophon from "../components/Colophon.astro";
import GithubActivity from "../components/GithubActivity.astro";
import FoldedLedger from "../components/FoldedLedger.astro";
import PhViewer from "../components/PhViewer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from "../consts";
import {
    EXPERIENCE,
    SHIPPING_ORDERED,
    RESUME_ROLE,
    RESUME_CONTACT,
} from "../data/resume";
import { WRITING_RELEVANCE } from "../data/writings";
import { getCollection } from "astro:content";
import "../styles/print.css";

const personLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: AUTHOR.name,
    jobTitle: AUTHOR.jobTitle,
    url: Astro.site?.href,
    description: SITE_DESCRIPTION,
    worksFor: { "@type": "Organization", name: "Netlify", url: "https://netlify.com" },
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Aryan International College",
    },
    sameAs: AUTHOR.sameAs,
};

const connectRows = [
    { label: "email", href: "mailto:hello@vaibhavacharya.com" },
    { label: "github", href: "https://github.com/VaibhavAcharya" },
    { label: "x/twitter", href: "https://x.com/VaibhavAcharya_" },
    { label: "bluesky", href: "https://bsky.app/profile/vaibhavacharya.bsky.social" },
    { label: "linkedin", href: "https://www.linkedin.com/in/vaibhav-acharya" },
];

function formatShortDate(d: Date): string {
    return d.toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
}

// The writings ledger is the whole archive now, so there is no separate index
// page to keep in step. It lands in relevance order; see src/data/writings.ts.
const relevance = (id: string) => {
    const rank = WRITING_RELEVANCE.indexOf(id);
    return rank === -1 ? WRITING_RELEVANCE.length : rank;
};

const writings = (await getCollection("writings"))
    .sort(
        (a, b) =>
            relevance(a.id) - relevance(b.id) ||
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    )
    .map((post) => ({
        name: post.data.title,
        href: `/writings/${post.id}/`,
        meta: formatShortDate(post.data.pubDate),
        description: post.data.description,
        sortKey: post.data.pubDate.valueOf(),
    }));
---

<!doctype html>
<html lang="en-IN">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} jsonLd={personLd} />
    </head>
    <body>
        <ThemeToggle />
        <main data-resume class="max-w-[580px] w-full mx-auto px-10 pt-14 pb-18 flex flex-col max-sm:px-6 max-sm:pt-10 max-sm:pb-12">
            <header data-resume-header class="flex flex-col">
                <div>
                    <h1 data-resume-name class="font-serif italic font-normal text-[clamp(42px,5.6vw,60px)] leading-[1.02] tracking-[-0.02em] m-0 text-ink [font-variation-settings:'opsz'_72]">
                        <span data-print-hide>Vaibhav Acharya,<br />engineer.</span>
                        <span data-print-only>{AUTHOR.name}</span>
                    </h1>

                    <p data-print-hide class="font-serif italic font-normal text-xl leading-[1.42] text-ink-muted max-w-[42ch] m-0 mt-6 [font-variation-settings:'opsz'_24]">
                        I work at the seam where product, design and engineering stop being separate jobs.
                    </p>

                    <div data-print-only>
                        <p data-resume-role class="font-serif italic font-normal text-xl text-ink-muted m-0 [font-variation-settings:'opsz'_24]">
                            {RESUME_ROLE}
                        </p>
                    </div>
                </div>

                <ul data-resume-contact data-print-only class="list-none p-0 m-0 flex flex-col gap-y-1 font-mono [font-variant-ligatures:none] text-[11.5px] tracking-[0.02em] text-ink-soft">
                    {RESUME_CONTACT.map((item) => (
                        <li><a href={item.href} class="link">{item.value}</a></li>
                    ))}
                </ul>
            </header>

            <div data-print-hide class="mt-13">
                <GithubActivity />
            </div>

            <!-- On paper the lead paragraph carries itself, without a greeting. -->
            <p data-resume-heading data-print-hide class="font-serif italic font-normal text-[17px] text-accent mt-13 mb-3.5 [font-variation-settings:'opsz'_24]">hello</p>
            <!-- The sheet leads with experience, where this is already the first row. -->
            <p data-entry-desc data-print-hide class="font-sans text-[15px] leading-[1.7] text-ink-muted max-w-[62ch] m-0 mb-2.5 body-line">
                Currently working at <a href="https://netlify.com" target="_blank" rel="noreferrer" data-umami-event="connect" data-umami-event-channel="netlify"><svg class="netlify-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.49 19.04h-.23L5.13 17.9v-.23l1.73-1.71h1.2l.15.15v1.2L6.5 19.04ZM5.13 6.31V6.1l1.13-1.13h.23L8.2 6.68v1.2l-.15.15h-1.2L5.13 6.31Zm9.96 9.09h-1.65l-.14-.13v-3.83c0-.68-.27-1.2-1.1-1.23-.42 0-.9 0-1.43.02l-.07.08v4.96l-.14.14H8.9l-.13-.14V8.73l.13-.14h3.7a2.6 2.6 0 0 1 2.61 2.6v4.08l-.13.14Zm-8.37-2.44H.14L0 12.82v-1.64l.14-.14h6.58l.14.14v1.64l-.14.14Zm17.14 0h-6.58l-.14-.14v-1.64l.14-.14h6.58l.14.14v1.64l-.14.14ZM11.05 6.55V1.64l.14-.14h1.65l.14.14v4.9l-.14.14h-1.65l-.14-.13Zm0 15.81v-4.9l.14-.14h1.65l.14.13v4.91l-.14.14h-1.65l-.14-.14Z"></path></svg>Netlify</a> as an engineer.
            </p>
            <p data-entry-desc class="font-sans text-[15px] leading-[1.7] text-ink-muted max-w-[62ch] m-0 body-line">
                I like going 0 to 1, shipping often, and operating independently. Most of what I care about lives where the web, AI and tools for builders overlap. Off hours, still building small products to find out whether they deserve to exist.
            </p>

            <div data-print-hide>
                <p class="font-serif italic font-normal text-[17px] text-accent mt-13 mb-3.5 [font-variation-settings:'opsz'_24]">connect</p>
                <ul class="list-none p-0 m-0 flex flex-wrap items-baseline gap-x-5 gap-y-2">
                    {connectRows.map((row) => (
                        <li>
                            <a
                                href={row.href}
                                target="_blank"
                                rel="noreferrer"
                                class="link font-mono [font-variant-ligatures:none] text-[11.5px] tracking-[0.02em] text-ink-soft"
                                data-umami-event="connect"
                                data-umami-event-channel={row.label}
                            >
                                {row.label}
                            </a>
                        </li>
                    ))}
                    <li>
                        <button
                            type="button"
                            data-print-resume
                            class="print-link font-mono [font-variant-ligatures:none] text-[11.5px] tracking-[0.02em] text-ink-soft"
                            data-umami-event="resume-print"
                        >
                            resume
                        </button>
                    </li>
                </ul>

            </div>

            <FoldedLedger
                id="writings"
                title="writings"
                groups={[{ entries: writings }]}
                sorts={["relevance", "latest", "oldest"]}
                print={false}
            />

            <FoldedLedger
                id="experience"
                mobileFoldOnly
                title="experience"
                groups={[{ entries: EXPERIENCE }]}
            />

            <FoldedLedger
                id="shipping"
                mobileFoldOnly
                title="fun shipping on the side"
                groups={SHIPPING_ORDERED}
                sorts={["relevance", "latest"]}
            />

            <div data-print-hide>
                <Colophon />
            </div>
        </main>

        <PhViewer />

        <script is:inline>
            document
                .querySelector("[data-print-resume]")
                ?.addEventListener("click", () => window.print());
        </script>
    </body>
</html>

<style>
    @reference "../styles/global.css";

    .body-line a {
        @apply text-ink;
        border-bottom: 1px solid var(--color-accent-50);
        padding-bottom: 1px;
        transition: border-color 120ms linear;
    }
    .body-line a:hover {
        border-color: var(--color-accent);
    }

    .print-link {
        appearance: none;
        background: none;
        border: 0;
        border-bottom: 1px solid var(--color-accent-50);
        padding: 0 0 1px;
        cursor: pointer;
        transition: border-color 120ms linear;
    }

    .print-link:hover {
        border-color: var(--color-accent);
    }

    /* Netlify's logomark, monochrome so it takes the colour of the text around it
       instead of dropping a brand gradient into the page. */
    .netlify-mark {
        display: inline-block;
        width: 0.84em;
        height: 0.84em;
        vertical-align: -0.07em;
        margin-right: 0.13em;
    }
</style>
