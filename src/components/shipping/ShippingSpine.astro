---
// Variant 03. The whole run collapses to a year spine: one tick per project,
// grouped under the year it started. Picking a tick swaps the single entry in
// the slot below, so the section never grows past two lines and one row.
//
// Radios drive it, so it works without JS and gets arrow-key navigation free.
// The ids are page-global, so render one of these per page.

import LedgerRow from "./LedgerRow.astro";
import PrintList from "./PrintList.astro";
import type { Entry } from "../../data/resume";

interface Group {
    label?: string;
    entries: Entry[];
}

interface Props {
    title: string;
    groups: Group[];
    printLimit?: number;
}

const { title, groups, printLimit } = Astro.props;

const flat = groups.flatMap((group) => group.entries);
const numbered = flat.map((entry, index) => ({ entry, n: index + 1 }));

const years = [...new Set(numbered.map(({ entry }) => entry.year ?? 0))]
    .sort((a, b) => a - b)
    .map((year) => ({
        year,
        label: year === 0 ? "undated" : String(year),
        items: numbered.filter(({ entry }) => (entry.year ?? 0) === year),
    }));

const rules = numbered
    .map(({ n }) =>
        [
            `#spine-${n}:checked~.spine [data-t="${n}"] .bar{background:var(--color-accent);height:24px}`,
            `#spine-${n}:checked~.spine-slot [data-p="${n}"]{opacity:1;visibility:visible;transform:none}`,
            `#spine-${n}:focus-visible~.spine [data-t="${n}"]{outline:1px dashed var(--color-accent);outline-offset:2px}`,
        ].join(""),
    )
    .join("");
---

<section data-resume-section>
    <h2 data-resume-heading class="font-serif italic font-normal text-[17px] text-accent mt-13 mb-4 [font-variation-settings:'opsz'_24]">
        {title}
    </h2>

    <div data-print-hide>
        {numbered.map(({ n }) => (
            <input type="radio" name="ship-spine" id={`spine-${n}`} class="sr-only" checked={n === 1} />
        ))}

        <div class="spine" style={`--cols:${years.length}`}>
            {years.map(({ items }) => (
                <div class="ticks">
                    {items.map(({ entry, n }) => (
                        <label class="tick" for={`spine-${n}`} data-t={n} data-name={entry.name}>
                            <span class="bar" aria-hidden="true"></span>
                            <span class="sr-only">{entry.name}</span>
                        </label>
                    ))}
                </div>
            ))}
            {years.map(({ label }) => (
                <span class="year font-mono [font-variant-ligatures:none] text-[10.5px] tracking-[0.04em] text-ink-soft">
                    {label}
                </span>
            ))}
        </div>

        <div class="spine-slot">
            {numbered.map(({ entry, n }) => (
                <div class="panel" data-p={n}>
                    <p class="font-mono [font-variant-ligatures:none] text-[10.5px] tracking-[0.06em] text-rule-dot m-0 mb-2">
                        {entry.group}
                    </p>
                    <LedgerRow n={n} entry={entry} mark="none" />
                </div>
            ))}
        </div>
    </div>

    <PrintList entries={flat} limit={printLimit} />
</section>

<style is:inline set:html={rules}></style>

<style>
    .spine {
        display: grid;
        grid-template-columns: repeat(var(--cols), 1fr);
        column-gap: 0;
        row-gap: 7px;
    }

    .ticks {
        grid-row: 1;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 3px;
        padding-bottom: 7px;
        border-bottom: 0.5px solid var(--color-rule-dot);
    }

    .year {
        grid-row: 2;
        text-align: center;
    }

    .tick {
        position: relative;
        display: flex;
        align-items: flex-end;
        padding: 8px 4px 0;
        cursor: pointer;
    }

    .bar {
        display: block;
        width: 2px;
        height: 11px;
        background: var(--color-rule-dot);
        transition:
            height 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
            background-color 160ms linear;
    }

    .tick:hover .bar {
        background: var(--color-ink);
        height: 18px;
    }

    @media (max-width: 480px) {
        .tick {
            padding-inline: 2px;
        }
    }

    @media (hover: hover) {
        .tick:hover::after {
            content: attr(data-name);
            position: absolute;
            bottom: calc(100% + 4px);
            left: 50%;
            transform: translateX(-50%);
            padding: 2px 6px;
            white-space: nowrap;
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: 0.02em;
            color: var(--color-ink);
            background: var(--color-paper);
            border: 0.5px solid var(--color-rule-dot);
            z-index: 2;
        }
    }

    /* Panels stack in one cell, so the slot is as tall as the longest entry and
       switching ticks never shifts the page. */
    .spine-slot {
        display: grid;
        margin-top: 20px;
    }

    .panel {
        grid-area: 1 / 1;
        opacity: 0;
        visibility: hidden;
        transform: translateY(3px);
        transition:
            opacity 180ms linear,
            transform 180ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    @media (prefers-reduced-motion: reduce) {
        .bar,
        .panel {
            transition: none;
        }
    }
</style>
